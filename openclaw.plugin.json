{
  "id": "clawmod",
  "name": "ClawMod",
  "description": "Security & Memory Enhancement Suite for OpenClaw",
  "version": "0.1.1",
  "author": "ClawMod Team",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "modules": {
        "type": "object",
        "properties": {
          "clawshield": {
            "type": "boolean",
            "default": true,
            "description": "Enable ClawShield security module"
          },
          "clawmem": {
            "type": "boolean",
            "default": true,
            "description": "Enable ClawMem memory module"
          },
          "clawsave": {
            "type": "boolean",
            "default": false,
            "description": "Enable ClawSave session persistence"
          },
          "clawresearch": {
            "type": "boolean",
            "default": false,
            "description": "Enable ClawResearch deep research capabilities"
          },
          "clawagent": {
            "type": "boolean",
            "default": false,
            "description": "Enable ClawAgent autonomous agent system"
          },
          "clawflow": {
            "type": "boolean",
            "default": false,
            "description": "Enable ClawFlow workflow orchestration"
          }
        }
      },
      "provider": {
        "type": "string",
        "enum": ["openrouter", "anthropic", "openai", "ollama"],
        "default": "openrouter",
        "description": "LLM provider to use for ClawMod operations"
      },
      "apiKeyEnv": {
        "type": "string",
        "default": "OPENROUTER_API_KEY",
        "description": "Environment variable name containing the API key"
      },
      "models": {
        "type": "object",
        "properties": {
          "scoring": {
            "type": "string",
            "default": "google/gemini-2.0-flash-lite",
            "description": "Model for importance scoring and memory evaluation"
          },
          "embedding": {
            "type": "string",
            "default": "openai/text-embedding-3-small",
            "description": "Model for generating embeddings for semantic search"
          },
          "extraction": {
            "type": "string",
            "default": "openai/gpt-4o-mini",
            "description": "Model for extracting entities and relationships"
          },
          "powerful": {
            "type": "string",
            "default": "anthropic/claude-sonnet-4",
            "description": "Powerful model for complex reasoning tasks"
          }
        }
      },
      "fallbacks": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": "Fallback model mappings if primary models fail"
      },
      "updates": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["auto", "notify", "manual", "disabled"],
            "default": "notify",
            "description": "How to handle ClawMod updates"
          },
          "channel": {
            "type": "string",
            "enum": ["stable", "beta", "dev"],
            "default": "stable",
            "description": "Update channel to follow"
          },
          "checkInterval": {
            "type": "number",
            "default": 86400000,
            "description": "Update check interval in milliseconds (default: 24 hours)"
          }
        }
      },
      "clawshield": {
        "type": "object",
        "properties": {
          "spotlighting": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "Enable spotlighting to mark untrusted input"
              },
              "tokenInterval": {
                "type": "number",
                "default": 5,
                "description": "Insert spotlight markers every N tokens"
              }
            }
          },
          "secretScanning": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "Scan for API keys and secrets"
              },
              "patterns": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": ["aws", "github", "openai", "generic"],
                "description": "Secret pattern types to detect"
              },
              "entropyThreshold": {
                "type": "number",
                "default": 4.5,
                "description": "Entropy threshold for detecting high-entropy strings"
              }
            }
          },
          "piiDetection": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "Detect and redact personally identifiable information"
              },
              "types": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": ["email", "phone", "ssn", "creditcard"],
                "description": "PII types to detect"
              },
              "redactionStyle": {
                "type": "string",
                "default": "[REDACTED]",
                "description": "Text to replace detected PII with"
              }
            }
          },
          "audit": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "Enable tamper-evident audit logging"
              },
              "retention": {
                "type": "number",
                "default": 90,
                "description": "Number of days to retain audit logs"
              }
            }
          }
        }
      },
      "clawmem": {
        "type": "object",
        "properties": {
          "tiers": {
            "type": "object",
            "properties": {
              "core": {
                "type": "object",
                "properties": {
                  "maxTokens": {
                    "type": "number",
                    "default": 2000,
                    "description": "Maximum tokens for core memories (always loaded)"
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": ["persona.md", "user_profile.md", "current_goals.md"],
                    "description": "Core memory file names"
                  }
                }
              },
              "recall": {
                "type": "object",
                "properties": {
                  "maxItems": {
                    "type": "number",
                    "default": 1000,
                    "description": "Maximum items in recall tier"
                  },
                  "embeddingThreshold": {
                    "type": "number",
                    "default": 0.7,
                    "description": "Minimum similarity threshold for recall"
                  }
                }
              },
              "archival": {
                "type": "object",
                "properties": {
                  "retentionDays": {
                    "type": "number",
                    "default": 365,
                    "description": "Days to retain archival memories"
                  },
                  "compression": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable compression for archival storage"
                  }
                }
              }
            }
          },
          "scoring": {
            "type": "object",
            "properties": {
              "minImportance": {
                "type": "number",
                "default": 3,
                "description": "Minimum importance score to store memories (1-10)"
              },
              "batchSize": {
                "type": "number",
                "default": 10,
                "description": "Batch size for importance scoring operations"
              }
            }
          },
          "decay": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "Enable memory decay over time (Ebbinghaus curve)"
              },
              "halfLifeHours": {
                "type": "number",
                "default": 168,
                "description": "Memory decay half-life in hours (default: 1 week)"
              },
              "minImportanceForNoDecay": {
                "type": "number",
                "default": 8,
                "description": "Memories with importance >= this never decay"
              },
              "pruneThreshold": {
                "type": "number",
                "default": 0.05,
                "description": "Strength threshold below which memories are pruned"
              },
              "pruneSchedule": {
                "type": "string",
                "default": "0 5 * * 0",
                "description": "Cron schedule for memory pruning (default: Sunday 5am)"
              }
            }
          },
          "consolidation": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "Enable memory consolidation (combining related memories)"
              },
              "schedule": {
                "type": "string",
                "default": "0 4 * * *",
                "description": "Cron schedule for consolidation (default: daily 4am)"
              },
              "minEpisodes": {
                "type": "number",
                "default": 5,
                "description": "Minimum episodes needed to trigger consolidation"
              },
              "maxEpisodes": {
                "type": "number",
                "default": 100,
                "description": "Maximum episodes to consolidate at once"
              }
            }
          },
          "contradiction": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "Enable contradiction detection in memories"
              },
              "similarityThreshold": {
                "type": "number",
                "default": 0.8,
                "description": "Similarity threshold for detecting contradictions"
              },
              "autoResolve": {
                "type": "boolean",
                "default": false,
                "description": "Automatically resolve contradictions (keeps newer memory)"
              }
            }
          },
          "graph": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "Enable knowledge graph for memory relationships"
              },
              "extractRelations": {
                "type": "boolean",
                "default": true,
                "description": "Extract entity relationships from memories"
              },
              "maxDepth": {
                "type": "number",
                "default": 3,
                "description": "Maximum graph traversal depth"
              }
            }
          },
          "retrieval": {
            "type": "object",
            "properties": {
              "weights": {
                "type": "object",
                "properties": {
                  "recency": {
                    "type": "number",
                    "default": 1.0,
                    "description": "Weight for recency in memory retrieval"
                  },
                  "importance": {
                    "type": "number",
                    "default": 1.0,
                    "description": "Weight for importance in memory retrieval"
                  },
                  "relevance": {
                    "type": "number",
                    "default": 1.5,
                    "description": "Weight for relevance in memory retrieval"
                  },
                  "frequency": {
                    "type": "number",
                    "default": 0.5,
                    "description": "Weight for access frequency in retrieval"
                  }
                }
              },
              "maxResults": {
                "type": "number",
                "default": 10,
                "description": "Maximum results to return from memory search"
              }
            }
          }
        }
      }
    }
  },
  "uiHints": {
    "modules.clawshield": {
      "label": "ClawShield (Security)",
      "description": "Scan for secrets, redact PII, prevent prompt injection"
    },
    "modules.clawmem": {
      "label": "ClawMem (Memory)",
      "description": "Persistent memory with intelligent decay"
    },
    "modules.clawsave": {
      "label": "ClawSave (Persistence)",
      "description": "Session persistence and recovery"
    },
    "modules.clawresearch": {
      "label": "ClawResearch (Research)",
      "description": "Deep research and information gathering"
    },
    "modules.clawagent": {
      "label": "ClawAgent (Autonomous)",
      "description": "Autonomous agent capabilities"
    },
    "modules.clawflow": {
      "label": "ClawFlow (Workflows)",
      "description": "Workflow orchestration and automation"
    },
